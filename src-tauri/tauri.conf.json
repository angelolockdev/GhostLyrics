{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GhostLyrics",
  "version": "0.2.4",
  "identifier": "com.ghostlyrics.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "GhostLyrics Overlay",
        "url": "index.html",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false,
        "skipTaskbar": true,
        "resizable": true,
        "width": 800,
        "height": 220
      },
      {
        "label": "settings",
        "title": "GhostLyrics — Paramètres",
        "url": "index.html",
        "visible": false,
        "decorations": true,
        "width": 660,
        "height": 660,
        "minWidth": 480,
        "minHeight": 400,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {}
}
